#!/usr/bin/env bash
# Managed by scripts/sync-agent-maintenance.mjs. Always preserve git's result.
# Manual pulls reconcile the checked-out instructions, skills, MCP policy, and
# runtime settings immediately; scheduled pulls use the same agent-sync path.
set +e

[[ "${AGENT_DOCTOR_SKIP_HOOK:-0}" == "1" ]] && exit 0

agent_root="${AGENT_REPO_ROOT:-$HOME/Projects/agent}"
sync="$agent_root/bin/agent-sync"
if [[ ! -x "$sync" ]] || ! command -v node >/dev/null 2>&1; then
  printf 'agent sync: skipped; checkout, launcher, or node missing\n' >&2
  exit 0
fi

output="$("$sync" --reconcile-only --quiet 2>&1)"
status=$?
if [[ "$status" -ne 0 ]]; then
  printf 'agent sync: reconciliation blocked after repository update\n' >&2
  [[ -n "$output" ]] && printf '%s\n' "$output" >&2
fi
exit 0
